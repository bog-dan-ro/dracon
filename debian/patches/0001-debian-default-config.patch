Description: Default to the standard HTTP/HTTPS ports, HTTPS off, in the packaged config
 Upstream's own defaults (8080/8443, HTTPS on with no certificate) are
 right for running build/bin/dracon straight out of a source checkout,
 but a system-installed web server is expected to answer :80 out of the
 box, and dracon.service already carries CAP_NET_BIND_SERVICE for exactly
 that. HTTPS stays configured for port 443 but disabled, since the
 package ships no certificate: enable it and point server_ssl_ctx.conf's
 Certificate/PrivateKey at a real (or self-signed, see
 conf/generate_cert.sh) key pair to turn it on.
Forwarded: not-needed
Author: BogDan Vatra <bogdan@kde.org>
--- a/conf/server.conf
+++ b/conf/server.conf
@@ -12,9 +12,9 @@ workload_balancing true ; enable/disable the workload balancing. When enabled th
                         ; Enabling this feature will slowdown the server with about 5%.
                         ; This feature it's enabled by default.

-http_port 8080 ; HTTP Port
+http_port 80 ; HTTP Port

-server_status true ; Enable or disable server_status plugin
+server_status false ; Enable or disable server_status plugin

 logging {
     #include "server_logging.conf"
@@ -33,8 +33,8 @@ privileges {
 }

 https {
-    enabled true
-    port 8443 ; HTTPS Port
+    enabled false ; no certificate is shipped, see conf/generate_cert.sh
+    port 443 ; HTTPS Port
     accept_timeout 5; seconds for SSL_accept
     shutdown_timeout 2; seconds for SSL_shutdown

