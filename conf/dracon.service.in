[Unit]
Description=Dracon HTTP server
Documentation=https://github.com/bog-dan-ro/dracon
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=10

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/dracon --conf @CMAKE_INSTALL_FULL_SYSCONFDIR@/dracon
Restart=always
RestartSec=1

# Dracon never needs to be root. It listens on 8080/8443 out of the box, and
# the ambient capability is only there so that server.conf can be moved to
# 80/443 without handing the service anything else. Drop both lines if you
# stay above 1024.
User=dracon
Group=dracon
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Carrying a very large number of concurrent connections is the whole point of
# this server, and one connection is one descriptor
LimitNOFILE=65536

# The server only ever reads: its configuration and whatever the plugins
# serve. Uncomment ProtectHome=read-only to serve ~user/public_html.
ProtectSystem=strict
ProtectHome=yes

LogsDirectory=dracon
LogsDirectoryMode=0750
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The accept thread asks for SCHED_RR and this denies it (so does the empty
# capability set): a real time accept loop can starve the rest of the box, and
# the server ignores the failure.
RestrictRealtime=yes

# Plugins are ordinary shared objects, so W^X costs nothing here. Remove it if
# a plugin of yours needs a JIT or libffi style trampolines.
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
